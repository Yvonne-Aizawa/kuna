<binaryimage arch="ARM:LE:32:v6:default">
<!--
    The 3DS kernel takes a supervisor call's number from the `svc` immediate and
    reads its arguments from r0..r5, but the SLEIGH lowering of `svc` is a
    CALLOTHER with no register inputs and no output, so every call prints as
    `software_interrupt(N)` with its arguments erased, and the handle a call
    writes to r1 is read back as the function's own incoming r1.

    Stage / sub-stage: P2 flow-classification.
    P0 assertion:      option ctrsvc off|on  (default off; the exheader flag sets it).

    close_handle is `svc 0x23; bx lr`: svcCloseHandle(handle).  make_mutex is
    `svc 0x13; mov r0, r1; bx lr`: svcCreateMutex writes the new handle to r1,
    so the returned r1 is the call's output, not the caller's parameter.
    map_block is `svc 0x1f`: svcMapMemoryBlock reads r0..r3.  unknown_svc is
    `svc 0xff`, a number outside the table, and stays a bare software_interrupt.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">
230000ef1eff2fe1130000ef0100a0e11eff2fe11f0000ef1eff2fe1ff0000ef
1eff2fe1
</bytechunk>
<symbol space="ram" offset="0x100000" name="close_handle"/>
<symbol space="ram" offset="0x100008" name="make_mutex"/>
<symbol space="ram" offset="0x100014" name="map_block"/>
<symbol space="ram" offset="0x10001c" name="unknown_svc"/>
</binaryimage>
<script>
  <com>option ctrsvc on</com>
  <com>lo fu close_handle</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu make_mutex</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu map_block</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu unknown_svc</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option ctrsvc off</com>
  <com>lo fu close_handle</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu make_mutex</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu map_block</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu unknown_svc</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="CTRSVC #1: with option ctrsvc on the handle is closed by a named call that reads r0" min="1" max="1">return svcCloseHandle\(a0\);</stringmatch>
<stringmatch name="CTRSVC #2: the handle svcCreateMutex writes to r1 is the call's output" min="1" max="1">svcCreateMutex\(a1\);</stringmatch>
<stringmatch name="CTRSVC #2b: the returned value is the call's r1 output" min="1" max="1">return svc_out\(\);</stringmatch>
<stringmatch name="CTRSVC #3: svcMapMemoryBlock reads r0..r3 and no more" min="1" max="1">return svcMapMemoryBlock\(a0,a1,a2,a3\);</stringmatch>
<stringmatch name="CTRSVC #4: a number outside the table stays a bare software_interrupt in both passes" min="2" max="2">software_interrupt\(0xff\);</stringmatch>
<stringmatch name="CTRSVC #5: with option ctrsvc off the 3DS calls keep the vendored model" min="1" max="1">software_interrupt\(0x23\);</stringmatch>
<stringmatch name="CTRSVC #6: with option ctrsvc off the mutex handle reads back as the caller's r1" min="1" max="1">return a1;</stringmatch>
</decompilertest>
